NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_live_...          # or sk_test_... for testing
STRIPE_PUBLISHABLE_KEY=pk_live_...     # (not used server-side, but handy to have)
